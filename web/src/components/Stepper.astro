---
const { kind = 'loop' } = Astro.props;
const lines = kind === 'loop'
 ? ['clusters = ["Communications", "Human Resources"]', 'for cluster in clusters:', '    print(cluster)']
 : kind === 'weighted'
 ? ['points_to_award = {"Communications": 2, "Human Resources": 1}', 'for cluster in points_to_award:', '    scores[cluster] += points_to_award[cluster]']
 : ['clusters = ["Events", "Office of the Secretary General"]', 'for cluster in clusters:', '    scores[cluster] += 1'];
---
<misa-stepper data-kind={kind} class="stepper" style="display:block">
<p><strong>{kind === 'loop' ? 'Watch a loop run' : kind === 'weighted' ? 'Watch a weighted answer' : 'Watch one answer award two points'}</strong></p>
{kind === 'score' && <p>Selected answer: "Put the schedule and room requirements in one document." Both scores start at zero.</p>}
{kind === 'weighted' && <p>Selected answer: "Create the event look and a welcome post for members." Both scores start at zero.</p>}
<pre aria-label="Python demonstration"><code>{lines.map((line,index) => <span data-line={index}>{line}</span>)}</code></pre>
<p data-state role="status" aria-live="polite">Ready. Press Step to assign the first item.</p>
<pre data-output aria-label={kind === 'loop' ? 'Accumulated output' : 'Current scores'}>{kind === 'loop' ? 'Output: (empty)' : kind === 'weighted' ? 'Communications: 0 · Human Resources: 0 · Total: 0' : 'Events: 0 · Office of the Secretary General: 0 · Total: 0'}</pre>
<button type="button" data-step>Step</button><button type="button" data-reset>Reset</button>
<noscript>This example needs JavaScript for stepping. Read the equivalent trace below.</noscript>
</misa-stepper>
<script>
import {loopState,scoreState,weightedState} from '../lib/steppers.mjs';
class MisaStepper extends HTMLElement {
 connectedCallback() {
  let step = 0;
  const advance = this.querySelector<HTMLButtonElement>('[data-step]')!;
  const reset = this.querySelector<HTMLButtonElement>('[data-reset]')!;
  const render = () => {
   const state = this.dataset.kind === 'score' ? scoreState(step) : this.dataset.kind === 'weighted' ? weightedState(step) : loopState(step);
   const scores: Record<string, number> | undefined = 'scores' in state ? state.scores : undefined;
   this.querySelectorAll<HTMLElement>('[data-line]').forEach(line => line.classList.toggle('current', step>0 && Number(line.dataset.line)===state.line));
   this.querySelector('[data-state]')!.textContent = step===0 ? 'Ready. Press Step to assign the first item.' : state.done ? `Done. No items remain. cluster still holds ${state.cluster}.` : `Step ${step} of 5. Line ${state.line+1}. cluster = "${state.cluster}".`;
   this.querySelector('[data-output]')!.textContent = 'output' in state ? `Output:\n${state.output?.join('\n') || '(empty)'}` : this.dataset.kind === 'weighted' ? `Communications: ${scores?.['Communications']} · Human Resources: ${scores?.['Human Resources']} · Total: ${state.total}` : `Events: ${scores?.Events} · Office of the Secretary General: ${scores?.['Office of the Secretary General']} · Total: ${state.total}`;
   advance.disabled = state.done;
  };
  advance.addEventListener('click',()=>{step++;render();});
  reset.addEventListener('click',()=>{step=0;render();});
  render();
 }
}
if (!customElements.get('misa-stepper')) customElements.define('misa-stepper',MisaStepper);
</script>
